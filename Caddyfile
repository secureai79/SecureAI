# TLS termination for the API. Certificates are issued and renewed automatically (Let's Encrypt).
{$API_DOMAIN} {
	encode zstd gzip

	# One hop in front of the app: Caddy sets X-Forwarded-For to the real client address.
	# (If you also put Cloudflare's orange-cloud proxy in front of Caddy, set TRUSTED_PROXY_COUNT=2.)
	reverse_proxy app:8000 {
		health_uri /ready
		health_interval 30s
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}

	log {
		output stdout
		format json
	}
}
