# Production settings for: Cloudflare Pages (frontend) + this API + Neon Postgres.
# Copy to .env.production (never commit it) and fill every blank. See docs/GO_LIVE.md.

ENVIRONMENT=production

# ---- URLs (https only) -------------------------------------------------------
# The address of the FRONTEND (Cloudflare Pages custom domain). E-mailed links point here.
FRONTEND_URL=https://app.example.com
# Exactly the frontend origin(s), comma separated. No wildcard, no trailing slash.
CORS_ALLOWED_ORIGINS=https://app.example.com
# Reverse proxies in front of the API: 1 = Caddy only, 2 = Cloudflare proxy + Caddy, PaaS router = usually 1.
TRUSTED_PROXY_COUNT=1

# ---- Secrets (generate with: python scripts/init_env.py --production or see docs/GO_LIVE.md) ----
JWT_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=
SOURCE_EVIDENCE_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=

# ---- Database: Neon ------------------------------------------------------------
# Neon console > Connection details. Paste the string as is (postgresql://...). Use the *direct* host for the
# first start (schema creation); the "-pooler" host is fine afterwards and is detected automatically.
DATABASE_URL=
DB_POOL_SIZE=5

# ---- E-mail (verification, password reset, invitations, support) ----------------
EMAIL_BACKEND=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# An address on a domain you verified with the provider (SPF + DKIM + DMARC), not a gmail.com address.
EMAIL_FROM=SecureAI <no-reply@example.com>
SUPPORT_EMAIL=support@example.com
APP_NAME=SecureAI
REQUIRE_EMAIL_VERIFICATION=true
PREVENT_ACCOUNT_ENUMERATION=true

# ---- GitHub App ------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Either mount the .pem (docker-compose.prod.yml does, from this host path) ...
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github_app_private_key.pem
# ... or, on platforms that cannot mount files, paste the whole PEM here (newlines as \n) and remove the mount:
# GITHUB_APP_PRIVATE_KEY=
ENABLE_LEGACY_GITHUB_OAUTH=false

# ---- Monitoring (optional but recommended) -------------------------------------------
SENTRY_DSN=
RELEASE=

# ---- Limits and privacy ---------------------------------------------------------------
MAX_SCAN_FILES=20000
MAX_SCAN_BYTES=209715200
MAX_SCAN_FILE_BYTES=2097152
SCAN_TIME_BUDGET_SECONDS=540
GIT_CLONE_TIMEOUT_SECONDS=600
MAX_CLONE_MB=1024
SCAN_RETENTION_DAYS=30
STORE_SOURCE_SNIPPETS=false
ENABLE_EXTERNAL_LLM_REFINEMENT=false
EXTERNAL_LLM_PRIVACY_ACK=
RATE_LIMIT_ENABLED=true
SCAN_WORKER_TIMEOUT_SECONDS=780
SCAN_WORKER_CPU_SECONDS=700
SCAN_WORKER_MEMORY_MB=1536
MAX_MEMBERS_PER_ORG=10
MAX_CONCURRENT_SCANS_PER_ORG=2
MAX_GLOBAL_CONCURRENT_SCANS=4
DAILY_SCANS_PER_ORG=50
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
