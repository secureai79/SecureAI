# SecureAI configuration. Copy to .env (or run: python scripts/init_env.py) and fill the blanks.
# NEVER commit .env. Every key must appear only ONCE (the last duplicate silently wins).
# If a value contains '$' wrap it in single quotes: SMTP_PASSWORD='ab$cd'

# ---------------------------------------------------------------- core
ENVIRONMENT=production
# Generated by `python scripts/init_env.py`; at least 32 bytes of randomness.
JWT_SECRET=
# Fernet keys:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=
SOURCE_EVIDENCE_ENCRYPTION_KEY=
# Encrypts two-factor seeds at rest. Optional: when blank, GITHUB_TOKEN_ENCRYPTION_KEY is used.
MFA_ENCRYPTION_KEY=
# Where the web pages are served (used for e-mailed links and CORS). https in real deployments.
FRONTEND_URL=http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Number of reverse proxies in FRONT of this API (nginx, Cloudflare, a load balancer...).
# Use 0 when clients connect directly: a non-zero value with no real proxy lets anyone spoof
# X-Forwarded-For and dodge the per-IP rate limits.
TRUSTED_PROXY_COUNT=0
# Largest accepted request body in bytes (default 1 MiB).
MAX_REQUEST_BYTES=1048576

# ---------------------------------------------------------------- database
# Use hex/alphanumeric only (python -c "import secrets;print(secrets.token_hex(24))").
# NOTE: Postgres only reads this on FIRST start of an empty volume. Changing it later requires
#   docker compose exec db psql -U aisafety -c "ALTER USER aisafety PASSWORD 'new'"
POSTGRES_USER=aisafety
POSTGRES_PASSWORD=
# Leave DATABASE_URL unset: compose builds it from the values above.
# DATABASE_URL=

# ---------------------------------------------------------------- e-mail (verification + password reset)
# smtp = real delivery | console = print links in the log (local dev only) | disabled
EMAIL_BACKEND=smtp
# Brevo:   smtp-relay.brevo.com : 587 : starttls   (login = the "SMTP login" shown in Brevo, NOT your account e-mail;
#                                                  password = an SMTP key from Brevo > SMTP & API)
# Resend:  smtp.resend.com : 465 : ssl             (username = resend, password = API key)
# Gmail:   smtp.gmail.com : 587 : starttls         (needs an App Password; fine for testing only)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Use an address on a domain you verified with the provider (SPF/DKIM), otherwise mail lands in spam.
EMAIL_FROM=SecureAI <no-reply@your-domain.example>
EMAIL_REPLY_TO=
APP_NAME=SecureAI
# Where Help & Support messages go (defaults to EMAIL_REPLY_TO, then to the EMAIL_FROM address).
SUPPORT_EMAIL=
# Block repositories/scans until the user confirms their e-mail.
REQUIRE_EMAIL_VERIFICATION=true
# Sign-up answers identically for new and already-registered e-mails (no account discovery). On in production.
PREVENT_ACCOUNT_ENUMERATION=true
EMAIL_VERIFICATION_TTL_HOURS=24
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_RESEND_MAX_PER_HOUR=5
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_PER_HOUR=3

# ---------------------------------------------------------------- GitHub App (production integration)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Host path of the downloaded .pem (mounted read-only into the container by docker-compose.yml).
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github_app_private_key.pem
ENABLE_LEGACY_GITHUB_OAUTH=false

# ---------------------------------------------------------------- limits and privacy
# Large repositories are scanned as far as these limits allow (likely AI/runtime code first) and the report
# says exactly what was skipped. Raise them if the host has the RAM/CPU; they scale with the plan (app/limits.py).
MAX_SCAN_FILES=20000
MAX_SCAN_BYTES=209715200
MAX_SCAN_FILE_BYTES=2097152
SCAN_TIME_BUDGET_SECONDS=540
GIT_CLONE_TIMEOUT_SECONDS=600
MAX_CLONE_MB=1024
SCAN_RETENTION_DAYS=30
STORE_SOURCE_SNIPPETS=false
ENABLE_EXTERNAL_LLM_REFINEMENT=false
# Only set to true after reviewing your external LLM data-processing terms.
EXTERNAL_LLM_PRIVACY_ACK=
RATE_LIMIT_ENABLED=true
SCAN_WORKER_TIMEOUT_SECONDS=780
SCAN_WORKER_CPU_SECONDS=700
SCAN_WORKER_MEMORY_MB=1536
SCAN_WORKER_FILE_MB=256
MAX_REPOS_PER_ORG=100
MAX_CONCURRENT_SCANS_PER_ORG=2
MAX_GLOBAL_CONCURRENT_SCANS=4
DAILY_SCANS_PER_ORG=50
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
RETENTION_SWEEP_SECONDS=21600
