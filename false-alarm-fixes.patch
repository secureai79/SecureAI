+def _is_fixed_dev_tooling(call_node: ast.Call) -> bool:
+    """A fixed argv list that runs dependency/VCS tooling (uv pip install, git clone...). These are
+    ordinary program logic; an AI cannot change what they do. Uninstall/publish/push stay reported."""
+    first = call_node.args[0] if call_node.args else None
+    if not isinstance(first, (ast.List, ast.Tuple)) or not first.elts:
+        return False
+    if not all(isinstance(e, ast.Constant) and isinstance(e.value, str) for e in first.elts[:2]):
+        return False                       # first two tokens must be literal (tool + subcommand)
+    argv = [e.value for e in first.elts if isinstance(e, ast.Constant)]
+    tool = argv[0].split()[0].replace("\\", "/").rsplit("/", 1)[-1].lower().removesuffix(".exe")
+    rest = {a.lower() for a in argv[1:]}
+    if rest & {"uninstall", "publish", "push", "remove", "rm", "delete"}:
+        return False
+    if tool in _PKG_TOOLS:
+        return True
+    if tool != "git":
+        return False
+    sub = next((a.lower() for a in argv[1:] if not a.startswith("-") or a in ("--version",)), "")
+    return sub in _GIT_READONLY_OR_FETCH or (len(argv) > 1 and argv[1].lower() in _GIT_READONLY_OR_FETCH)
+
