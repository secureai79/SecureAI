+def _is_internal_plumbing(operation: str, chain: str) -> bool:
+    """`buffer.push(x)`, `super().push()`, `websocket.send(frame)` are data-structure / transport calls,
+    not pushing code to a remote or messaging a person."""
+    root = chain.rsplit(".", 1)[0] if "." in chain else ""
+    if operation == "terminate":
+        # Popen.terminate() on a child-process handle ends the program's own subprocess; cloud
+        # terminate_instances / terminate(...) on other objects stays reported.
+        return bool(re.search(r"(?i)(?:^|[._])(?:proc|process|_process|popen|child|subprocess|worker)$", root))
+    if operation == "send" and (root in ("self", "cls") or chain == "Send" or root.endswith(".chat")):
+        return True        # own-method / graph-routing Send() / LLM chat.send are not messaging a person
+    if operation == "push":
+        return not _PUSH_TARGET.search(root)
+    if operation == "send":
+        return bool(_TRANSPORT_ROOT.search(root)) or root.startswith("super")
+    return False
